#!/usr/bin/env python3
"""讓動畫引擎以為這是 piper 語音引擎,實際用 Google 語音(gTTS)產生配音。"""
import subprocess, sys, tempfile, os
args = sys.argv[1:]
if "--help" in args or not args:
    print("piper shim (gTTS)"); sys.exit(0)
lang = args[args.index("--model") + 1] if "--model" in args else "zh-TW"
out = args[args.index("--output_file") + 1]
text = sys.stdin.read().strip()
from gtts import gTTS
with tempfile.TemporaryDirectory() as tmp:
    mp3 = os.path.join(tmp, "v.mp3")
    gTTS(text, lang=lang).save(mp3)
    speed = os.environ.get("VOICE_SPEED", "1.25")
    subprocess.run(["ffmpeg", "-y", "-v", "error", "-i", mp3, "-af", f"atempo={speed}",
                    "-ar", "48000", "-ac", "1", out], check=True)
