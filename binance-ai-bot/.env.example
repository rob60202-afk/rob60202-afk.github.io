# ===== 交易模式 =====
# paper   = 紙上交易（只抓公開行情，不下真單，不需要 API Key）← 預設、建議先跑這個
# testnet = 幣安現貨測試網（假錢、真下單流程），Key 到 https://testnet.binance.vision 申請
# live    = 真實帳戶真錢下單（另外必須把 LIVE_CONFIRM 設成 I_UNDERSTAND_THE_RISK）
MODE=paper
LIVE_CONFIRM=

BINANCE_API_KEY=
BINANCE_API_SECRET=

# ===== 交易標的 =====
SYMBOL=BTC/USDT
TIMEFRAME=1h
# 訓練模型用的 K 棒數（1h * 5000 ≈ 7 個月）
TRAIN_BARS=5000

# ===== AI 模型 =====
# 預測未來幾根 K 棒
HORIZON=4
# 預測上漲機率 >= 此值才進場
ENTRY_PROBA=0.60
# 持倉中，預測機率 <= 此值就出場
EXIT_PROBA=0.45
# 模型超過幾小時就重新訓練
RETRAIN_HOURS=24

# ===== 風控 =====
# 每筆交易最多虧損總資金的比例（0.01 = 1%）
RISK_PER_TRADE=0.01
# 單筆部位最多佔總資金比例
MAX_POSITION_PCT=0.30
# 停損 = ATR * 倍數；停利 = ATR * 倍數
STOP_ATR_MULT=2.0
TAKE_PROFIT_ATR_MULT=3.0
# 單日虧損達總資金比例就停止當日交易
MAX_DAILY_LOSS_PCT=0.03
# 連續虧損幾筆就暫停交易（需人工把 state.json 的 halted 改回 false）
MAX_CONSECUTIVE_LOSSES=4
# 手續費（幣安現貨一般 0.1%）
FEE_RATE=0.001

# ===== A. 異常波動暫停 =====
# 單根 K 棒波幅超過「平常（前一根 ATR）」的幾倍就算異常；設 0 = 停用
SHOCK_ATR_MULT=3
# 偵測到異常後，幾小時內不開新倉
SHOCK_PAUSE_HOURS=6

# ===== B. 重大事件避開 =====
# 事件清單檔（FOMC 利率決議、CPI 公布等），可自行增減
EVENTS_FILE=events.csv
# 事件前幾小時、後幾小時不開新倉；兩個都設 0 = 停用
EVENT_BEFORE_HOURS=2
EVENT_AFTER_HOURS=2

# paper 模式起始資金（USDT）
PAPER_START_BALANCE=1000
# 輪詢間隔（秒）
POLL_SECONDS=60
